# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# PORT: Server port (defaults to 3000 in AI Studio / Cloud Run)
PORT=3000

# SUPABASE_URL: Optional Supabase PostgreSQL project URL for persistent cloud DB
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Supabase anonymous client key
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Optional Supabase service role key (backend only, never exposed to frontend)
SUPABASE_SERVICE_ROLE_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

